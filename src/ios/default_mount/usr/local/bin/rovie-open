#!/bin/sh
# rovie-open — Rovie URL interceptor for iSH.
#
# Stands in for xdg-open / sensible-browser / www-browser / BROWSER, and also
# doubles as the in-app preview opener for chat resources. Any argument is
# emitted to stdout wrapped in an OSC 1337 escape sequence that the Rovie
# host parses and routes to the appropriate built-in viewer:
#
#   * http:// https:// about:*                 → WKWebView link preview
#   * /var/rovie/<host>/<path>  (absolute)     → converted to rovie://<host>/<path>
#   * /var/minis/<host>/<path>  (absolute)     → converted to rovie://<host>/<path>
#     rovie://attachments/...  rovie://workspace/...  rovie://shared/... etc.
#                                              → routed by extension:
#                                                 images → image viewer
#                                                 markdown → markdown preview
#                                                 html → html preview
#                                                 pdf/office → QuickLook
#                                                 audio/video → media player
#                                                 else → share sheet
#
# Protocol: ESC ] 1337 ; MinisOpenURL = <url> BEL
#   - ESC = 0x1B, BEL = 0x07
#   - Host scanner strips the whole sequence from the displayed output.
#
# Exit 0 always when we emitted something: the caller should believe the
# viewer was opened.

set -e

ESC=$(printf '\033')
BEL=$(printf '\007')

emit_marker() {
    printf '%s]1337;MinisOpenURL=%s%s\n' "$ESC" "$1" "$BEL"
}

emit() {
    case "$1" in
        http://*|https://*|about:*)
            emit_marker "$1"
            printf 'Opened in Rovie browser: %s\n' "$1"
            ;;
        rovie://*|minis://*)
            emit_marker "$1"
            printf 'Opened in Rovie preview: %s\n' "$1"
            ;;
        /var/rovie/*)
            rel="${1#/var/rovie/}"
            case "$rel" in
                */*)
                    host="${rel%%/*}"
                    path="${rel#*/}"
                    emit_marker "rovie://$host/$path"
                    printf 'Opened in Rovie preview: rovie://%s/%s\n' "$host" "$path"
                    ;;
                *)
                    printf 'rovie-open: not a previewable resource: %s\n' "$1" >&2
                    return 0
                    ;;
            esac
            ;;
        /var/minis/*)
            rel="${1#/var/minis/}"
            case "$rel" in
                */*)
                    host="${rel%%/*}"
                    path="${rel#*/}"
                    emit_marker "rovie://$host/$path"
                    printf 'Opened in Rovie preview: rovie://%s/%s\n' "$host" "$path"
                    ;;
                *)
                    printf 'rovie-open: not a previewable resource: %s\n' "$1" >&2
                    return 0
                    ;;
            esac
            ;;
        *)
            printf 'rovie-open: not a URL or chat resource, ignoring: %s\n' "$1" >&2
            return 0
            ;;
    esac
}

if [ $# -eq 0 ]; then
    echo "Usage: rovie-open <url-or-path>" >&2
    echo "  url-or-path: http(s):// URL, rovie:// URL, or /var/rovie/<host>/<path>" >&2
    exit 1
fi

for arg in "$@"; do
    emit "$arg"
done

exit 0

